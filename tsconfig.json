{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@controllers": ["./controllers/index"],
      "@controllers/*": ["./controllers/*"],
      "@data": ["./data/index"],
      "@data/*": ["./data/*"],
      "@db": ["./db/index"],
      "@db/*": ["./db/*"],
      "@examples": ["./examples/index"],
      "@examples/*": ["./examples/*"],
      "@functions": ["./functions/index"],
      "@functions/*": ["./functions/*"],
      "@middleware": ["./middleware/index"],
      "@middleware/*": ["./middleware/*"],
      "@models": ["./models/index"],
      "@models/*": ["./models/*"],
      "@plugins": ["./plugins/index"],
      "@plugins/*": ["./plugins/*"],
      "@postman": ["./postman/index"],
      "@postman/*": ["./postman/*"],
      "@routes": ["./routes/index"],
      "@routes/*": ["./routes/*"],
      "@schemas": ["./schemas/index"],
      "@schemas/*": ["./schemas/*"],
      "@scripts": ["./scripts/index"],
      "@scripts/*": ["./scripts/*"],
      "@tests": ["./tests/index"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx"],
  "exclude": ["node_modules", "build", "dist", "tests", "scripts/data"]
}
